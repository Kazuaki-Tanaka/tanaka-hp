---
interface Props {
  items: { period: string; description: string }[];
}
const { items } = Astro.props;
---

<div class="space-y-4">
  {items.map((item) => (
    <div class="flex gap-4 group">
      <div class="flex flex-col items-center">
        <div class="w-2.5 h-2.5 rounded-full bg-primary mt-1.5 shrink-0"></div>
        <div class="w-px flex-1 bg-border group-last:bg-transparent"></div>
      </div>
      <div class="pb-4 group-last:pb-0">
        <div class="text-sm font-medium text-primary">{item.period}</div>
        <div class="text-text mt-0.5">{item.description}</div>
      </div>
    </div>
  ))}
</div>
