---
interface Props {
  items: { label: string; value: string }[];
}
const { items } = Astro.props;
---

<dl class="space-y-3">
  {items.map((item) => (
    <div class="flex flex-col sm:flex-row sm:gap-4">
      <dt class="text-sm font-semibold text-text-muted sm:w-32 shrink-0">{item.label}</dt>
      <dd class="text-text">{item.value}</dd>
    </div>
  ))}
</dl>
