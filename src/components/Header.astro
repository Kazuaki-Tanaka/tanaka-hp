---
import { getLangFromUrl, useTranslations, getNavItems, languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const navItems = getNavItems(lang);
const otherLang = lang === 'ja' ? 'en' : 'ja';
const pathname = Astro.url.pathname;
const currentPath = pathname === '/' ? '/' : pathname.replace(`/${lang}`, '');
const switchUrl = `/${otherLang}${currentPath}`;

const isActive = (href: string) =>
  pathname === href ||
  (href.endsWith('/') && pathname + '/' === href) ||
  (href === `/${lang}/` && pathname === '/');
---

<header class="bg-white border-b border-border sticky top-0 z-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      <a href={`/${lang}/`} class="font-bold text-lg text-primary hover:text-primary-light transition-colors">
        {t('site.title')}
      </a>
      <div class="flex items-center gap-4">
        <nav class="hidden md:flex items-center gap-1">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'px-3 py-2 rounded-md text-sm font-medium transition-colors',
                isActive(item.href)
                  ? 'bg-primary/10 text-primary'
                  : 'text-text-muted hover:text-text hover:bg-gray-100',
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <a
          href={switchUrl}
          data-lang={otherLang}
          class="lang-switch text-sm px-3 py-1.5 rounded-md border border-border text-text-muted hover:text-text hover:border-primary transition-colors"
        >
          {languages[otherLang]}
        </a>
        <button id="menu-toggle" class="md:hidden p-2 text-text-muted hover:text-text" aria-label="メニュー">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
    <nav id="mobile-menu" class="md:hidden hidden pb-4 border-t border-border">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'block px-3 py-2 rounded-md text-sm font-medium transition-colors',
            isActive(item.href)
              ? 'bg-primary/10 text-primary'
              : 'text-text-muted hover:text-text hover:bg-gray-100',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
  document.querySelectorAll('.lang-switch').forEach((el) => {
    el.addEventListener('click', () => {
      const next = el.getAttribute('data-lang');
      if (next === 'ja' || next === 'en') localStorage.setItem('lang', next);
    });
  });
</script>
