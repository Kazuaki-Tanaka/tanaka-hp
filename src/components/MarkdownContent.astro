---
interface Props {
  html: string;
}
const { html } = Astro.props;
---

<div
  class="prose prose-gray max-w-none
    prose-headings:text-primary prose-headings:font-bold
    prose-h2:text-lg prose-h2:mt-0 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-border
    prose-h3:text-base prose-h3:mt-5 prose-h3:mb-3
    prose-p:my-2 prose-p:leading-relaxed
    prose-li:my-0 prose-li:leading-relaxed
    prose-a:text-accent prose-a:no-underline hover:prose-a:underline
    prose-ul:my-2 prose-ol:my-2
    prose-strong:text-text"
  set:html={html}
/>
