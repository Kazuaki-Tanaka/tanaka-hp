---
import BaseLayout from '../layouts/BaseLayout.astro';
import JaHome from '../components/JaHome.astro';
---

<BaseLayout title="田中 一成 (TANAKA, Kazuaki)" description="田中 一成 プロフィール">
  <script is:inline slot="head">
    (function () {
      try {
        var pref = localStorage.getItem('lang');
        if (pref === 'ja') return;
        var browser = String(navigator.language || '').toLowerCase();
        if (pref === 'en' || !browser.startsWith('ja')) location.replace('/en/');
      } catch (e) {}
    })();
  </script>
  <JaHome />
</BaseLayout>
