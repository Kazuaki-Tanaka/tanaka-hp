---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import InfoList from '../../components/InfoList.astro';
import Timeline from '../../components/Timeline.astro';
import BadgeList from '../../components/BadgeList.astro';
---

<BaseLayout title="Kazuaki Tanaka" description="Kazuaki Tanaka - About Me">
  <!-- Hero -->
  <div class="bg-bg-card rounded-xl border border-border shadow-sm p-6 sm:p-8 mb-6">
    <h1 class="text-3xl sm:text-4xl font-bold text-primary">Kazuaki Tanaka</h1>
    <p class="text-text mt-3">Chief Researcher, Fundamental Research Dept., <a href="https://www.ricos.co.jp/en/" class="text-accent hover:underline" target="_blank" rel="noopener">RICOS Co. Ltd.</a></p>
    <p class="text-text">Adjunct Researcher, <a href="https://www.waseda.jp/fsci/wise/" class="text-accent hover:underline" target="_blank" rel="noopener">Research Institute for Science and Engineering, Waseda University</a></p>
    <p class="text-text">Representative Director, <a href="https://masic.jp/" class="text-accent hover:underline" target="_blank" rel="noopener">Mathematics for Social Implementation Center (MaSIC)</a></p>
    <p class="text-text-muted text-sm">Ph.D. / JST FOREST Researcher</p>
  </div>

  <div class="space-y-6">
    <!-- Contact -->
    <Section title="Contact">
      <InfoList items={[
        { label: "Email", value: "tanaka [at] ims.sci.waseda.ac.jp" },
      ]} />
    </Section>

    <!-- Keywords -->
    <Section title="Keywords">
      <BadgeList items={["Validation Mathematics", "Deep Learning", "Partial Differential Equations", "Rigorous Computation", "Computer-Assisted Proofs", "Numerical Analysis"]} />
    </Section>

    <!-- Education -->
    <Section title="Education">
      <Timeline items={[
        { period: "Apr. 2014 – Mar. 2017", description: "Graduate School of Fundamental Science and Engineering, Waseda University (Doctor course)" },
        { period: "Apr. 2012 – Mar. 2014", description: "Graduate School of Fundamental Science and Engineering, Waseda University (Master course)" },
        { period: "Apr. 2008 – Mar. 2012", description: "Department of Applied Mathematics, School of Fundamental Science and Engineering, Waseda University" },
      ]} />
    </Section>

    <!-- Career -->
    <Section title="Career">
      <Timeline items={[
        { period: "Sep. 2026 –", description: "Chief Researcher, Fundamental Research Dept., RICOS Co. Ltd." },
        { period: "Sep. 2026 –", description: "Adjunct Researcher, Research Institute for Science and Engineering, Waseda University" },
        { period: "Apr. 2026 –", description: "Representative Director, Mathematics for Social Implementation Center (MaSIC)" },
        { period: "Apr. 2023 – Aug. 2026", description: "Associate Professor, Global Center for Science and Engineering, Faculty of Science and Engineering, Waseda University" },
        { period: "Apr. 2018 – Mar. 2023", description: "Assistant Professor, Institute for Mathematical Science, Waseda University" },
        { period: "Apr. 2017 – Mar. 2018", description: "Assistant Professor, Department of Applied Mathematics, Faculty of Science and Engineering, Waseda University" },
      ]} />
    </Section>

    <!-- Prizes -->
    <Section title="Prizes">
      <div class="space-y-3">
        {[
          { year: "2023", title: "The 12th WASEDA e-Teaching Award", url: "https://www.waseda.jp/inst/ches/news/2023/07/05/5232/" },
          { year: "2023", title: "Engineering Education Award, Japanese Society for Engineering Education", url: "https://www.jstage.jst.go.jp/article/jsee/71/6/71_6_49/_pdf/-char/ja" },
          { year: "2022", title: "Outstanding Presentation Award, JSST 2022" },
          { year: "2022", title: "Grantees FOS Recipients, Funai Foundation For Information Technology", url: "https://old.funaifoundation.jp/grantees/young_awardees_up_to_now_21.html" },
          { year: "2020", title: "The 8th WASEDA e-Teaching Award (Grand Award)", url: "https://www.waseda.jp/inst/ches/news/2020/04/06/2885/" },
          { year: "2016", title: "Poster Award, Annual conference of JSIAM", url: "https://annual2016.jsiam.org/2553" },
          { year: "2016", title: "Isao Okawa Memorial Achievement Award, Waseda University" },
          { year: "2014", title: "Student Presentation Award, JSST 2014" },
          { year: "2013", title: "Student Presentation Award, JSST 2013" },
          { year: "2010", title: "Encouragement award, Waseda Manufacturing Contest" },
        ].map((item) => (
          <div class="flex gap-3 items-baseline">
            <span class="text-sm font-mono text-primary shrink-0 w-12">{item.year}</span>
            {item.url ? (
              <a href={item.url} class="text-accent hover:underline" target="_blank" rel="noopener">{item.title}</a>
            ) : (
              <span class="text-text">{item.title}</span>
            )}
          </div>
        ))}
      </div>
    </Section>

    <!-- Grants -->
    <Section title="Grants">
      <div class="space-y-4">
        {[
          { period: "Oct. 2025 – Mar. 2031", title: "Designing Order: Predictive Mathematics for the Control of Natural River Dynamics", source: "JST CREST", role: "Collaborator", url: "https://www.jst.go.jp/kisoken/crest/en/project/1111123/1111123_2025.html" },
          { period: "Apr. 2021 – Mar. 2028", title: "精度保証付きニューラルネットワーク数値計算理論の確立", source: "JST FOREST", role: "PI", url: "https://projectdb.jst.go.jp/grant/JST-PROJECT-20353003/" },
          { period: "Apr. 2024 – Mar. 2028", title: "Elucidation of the stabilisation mechanism of naturally-derived river channel based on observation big data during floods and identification of river channel design indicators", source: "KAKENHI Scientific Research (A)", role: "Co-Investigator", url: "https://kaken.nii.ac.jp/grant/KAKENHI-PROJECT-24H00365/" },
          { period: "Apr. 2025 – Sep. 2026", title: "精度保証付きPINNsの開発と実問題への応用", source: "68th Engineering Research Grant, Mizuho Foundation for the Promotion of Sciences", role: "PI" },
          { period: "Apr. 2023 – Mar. 2026", title: "不連続拡散係数を持つ反応拡散モデルに対する精度保証付き数値計算法", source: "KAKENHI Early-Career Scientists", role: "PI", url: "https://kaken.nii.ac.jp/grant/KAKENHI-PROJECT-23K13020/" },
          { period: "Jan. 2022 – Dec. 2023", title: "急激な温度変化を伴う反応拡散現象に対する精度保証付き数値計算法に関する研究", source: "Kayamori Foundation of Informational Science Advancement", role: "PI", url: "https://www.kayamorif.or.jp/j-kj/j-kj_2021.pdf" },
          { period: "Jan. 2021 – Dec. 2021", title: "相分離現象解明のための精度保証付き数値計算法", source: "The Okawa Foundation for Information and Telecommunications", role: "PI" },
          { period: "Apr. 2019 – Mar. 2022", title: "Sign-change structure analysis for reaction-diffusion models based on rigorous numerical computation", source: "KAKENHI Early-Career Scientists", role: "PI", url: "https://kaken.nii.ac.jp/grant/KAKENHI-PROJECT-19K14601/" },
          { period: "Aug. 2017 – Mar. 2019", title: "Verified numerical computation for solutions to partial differential equations describing reaction diffusion models", source: "KAKENHI Research Activity Start-up", role: "PI", url: "https://kaken.nii.ac.jp/grant/KAKENHI-PROJECT-17H07188/" },
          { period: "Apr. 2017 – Mar. 2020", title: "反応拡散モデルを記述する偏微分方程式の正値解に対する精度保証付き数値計算法と関連する数学上の問題に関する研究", source: "60th Engineering Research Grant, Mizuho Foundation for the Promotion of Sciences", role: "PI" },
        ].map((item) => (
          <div class="border-l-2 border-primary/30 pl-4">
            <div class="text-sm font-mono text-text-muted">{item.period}</div>
            {item.url ? (
              <a href={item.url} class="text-accent hover:underline mt-0.5 inline-block" target="_blank" rel="noopener">{item.title}</a>
            ) : (
              <div class="text-text mt-0.5">{item.title}</div>
            )}
            <div class="flex gap-2 mt-1">
              <span class="text-xs bg-gray-100 text-text-muted px-2 py-0.5 rounded">{item.source}</span>
              <span class="text-xs bg-primary/8 text-primary px-2 py-0.5 rounded">{item.role}</span>
            </div>
          </div>
        ))}
      </div>
    </Section>

    <!-- Academic Activities -->
    <Section title="Academic Activities">
      <div class="space-y-2.5">
        {[
          { period: "2022", description: "Organizer, International Workshop on Reliable Computing and Computer-Assisted Proofs (ReCAP 2022), March 13-18, Online", url: "https://www.recap.sci.waseda.ac.jp/recap2022/" },
          { period: "2019", description: "Organizer of Minisymposium \"Numerical verification methods and their application to differential equations\", ICIAM 2019, July 15-19, Valencia, Spain", url: "https://iciam.org/events/2019/jul/14/iciam-2019-valencia-spain" },
          { period: "2018", description: "Organization Committee, Secretary, SCAN 2018, Waseda University, Sep. 10-15, 2018" },
          { period: "2018", description: "Local Organizer, SIAM Conference on Parallel Processing for Scientific Computing, Waseda University, Mar. 7-10, 2018", url: "http://siampp18.jsiam.org/" },
        ].map((item) => (
          <div class="flex gap-3 items-baseline">
            <span class="text-sm text-text-muted shrink-0 w-14">{item.period}</span>
            {item.url ? (
              <a href={item.url} class="text-accent hover:underline" target="_blank" rel="noopener">{item.description}</a>
            ) : (
              <span class="text-text">{item.description}</span>
            )}
          </div>
        ))}
      </div>
    </Section>
  </div>
</BaseLayout>
